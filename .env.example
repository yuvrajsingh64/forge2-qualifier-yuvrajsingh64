# Groq API key (get from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API key (get from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Slack tokens (get from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Slack channel IDs
SLACK_CHANNEL_SPRINT_MAIN=C0XXXXXXX
SLACK_CHANNEL_AGENT_CODER=C0YYYYYYY
SLACK_CHANNEL_AGENT_LOG=C0ZZZZZZZ

# Laravel backend URL (used by React frontend)
VITE_API_BASE_URL=http://localhost:8000/api
